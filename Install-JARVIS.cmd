@echo off
setlocal
title JARVIS Windows setup
set "JARVIS_SETUP_VERIFY_ONLY=0"
if /i "%~1"=="--verify-only" set "JARVIS_SETUP_VERIFY_ONLY=1"
echo JARVIS Windows setup
echo Downloading and verifying the latest published Windows installer.
echo No Python, Git, Node.js, or API key is required.
echo.
powershell.exe -NoLogo -NoProfile -Command "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue'; $setupDir = $null; try { if (-not [Environment]::Is64BitOperatingSystem) { throw 'JARVIS needs 64-bit Windows.' }; [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12; $headers = @{ 'User-Agent' = 'JARVIS-Windows-Setup'; 'Accept' = 'application/vnd.github+json'; 'X-GitHub-Api-Version' = '2022-11-28' }; if ($env:GITHUB_TOKEN) { $headers['Authorization'] = 'Bearer ' + $env:GITHUB_TOKEN }; $repo = 'https://github.com/cutebody42-web/JARVIS-OS-V.2'; $releases = Invoke-RestMethod -Uri 'https://api.github.com/repos/cutebody42-web/JARVIS-OS-V.2/releases?per_page=30' -Headers $headers -TimeoutSec 60; $release = $releases | Where-Object { -not $_.draft -and $_.tag_name -cmatch '^jarvis-preview-[0-9a-f]{12}$' } | Sort-Object { $when = $_.published_at; if ($when -is [DateTime] -or $when -is [DateTimeOffset]) { [DateTimeOffset]$when } else { [DateTimeOffset]::ParseExact([string]$when, 'yyyy-MM-ddTHH:mm:ssZ', [Globalization.CultureInfo]::InvariantCulture, [Globalization.DateTimeStyles]::AssumeUniversal) } } -Descending | Select-Object -First 1; if ($null -eq $release) { throw 'No validated JARVIS installer has been published yet. Try again after the release checks finish.' }; $setupAssets = @($release.assets | Where-Object { $_.name -ceq 'JARVIS-Setup.exe' }); $manifestAssets = @($release.assets | Where-Object { $_.name -ceq 'jarvis-update.json' }); if ($setupAssets.Count -ne 1 -or $manifestAssets.Count -ne 1) { throw 'The release is incomplete. Nothing will be installed.' }; $setupAsset = $setupAssets[0]; $manifestAsset = $manifestAssets[0]; if ($setupAsset.size -lt 1024 -or $setupAsset.size -gt 1073741824 -or $manifestAsset.size -lt 2 -or $manifestAsset.size -gt 262144) { throw 'The release asset sizes are invalid.' }; $baseUrl = $repo + '/releases/download/' + $release.tag_name + '/'; if ($setupAsset.browser_download_url -cne ($baseUrl + 'JARVIS-Setup.exe') -or $manifestAsset.browser_download_url -cne ($baseUrl + 'jarvis-update.json')) { throw 'The release contains an unexpected download address.' }; if ([string]::IsNullOrWhiteSpace($env:LOCALAPPDATA)) { throw 'Windows did not provide a local application-data folder.' }; $setupDir = Join-Path $env:LOCALAPPDATA ('JARVIS\setup-cache\' + [Guid]::NewGuid().ToString('N')); New-Item -ItemType Directory -Path $setupDir -ErrorAction Stop | Out-Null; $manifestPath = Join-Path $setupDir 'jarvis-update.json'; $installer = Join-Path $setupDir 'JARVIS-Setup.exe'; Write-Host ('Release: ' + $release.tag_name); Invoke-WebRequest -UseBasicParsing -Uri ($baseUrl + 'jarvis-update.json') -OutFile $manifestPath -TimeoutSec 60; if ((Get-Item -LiteralPath $manifestPath).Length -ne $manifestAsset.size) { throw 'The downloaded release manifest has the wrong size.' }; if ($manifestAsset.digest -and $manifestAsset.digest -cne ('sha256:' + (Get-FileHash -LiteralPath $manifestPath -Algorithm SHA256).Hash.ToLowerInvariant())) { throw 'The GitHub manifest checksum is incorrect.' }; $manifest = Get-Content -LiteralPath $manifestPath -Raw | ConvertFrom-Json; if ($manifest.commit_sha -cnotmatch '^[0-9a-f]{40}$' -or $manifest.release_tag -cne $release.tag_name -or $release.tag_name -cne ('jarvis-preview-' + $manifest.commit_sha.Substring(0, 12)) -or $manifest.artifact_name -cne 'JARVIS-Setup.exe' -or $manifest.artifact_sha256 -cnotmatch '^[0-9a-f]{64}$') { throw 'The release manifest does not match this installer.' }; Write-Host ('Downloading ' + [Math]::Round($setupAsset.size / 1MB) + ' MB. This can take several minutes.'); Invoke-WebRequest -UseBasicParsing -Uri ($baseUrl + 'JARVIS-Setup.exe') -OutFile $installer -TimeoutSec 1800; if ((Get-Item -LiteralPath $installer).Length -ne $setupAsset.size) { throw 'The installer download is incomplete. Run setup again.' }; $actualHash = (Get-FileHash -LiteralPath $installer -Algorithm SHA256).Hash.ToLowerInvariant(); if ($actualHash -cne $manifest.artifact_sha256) { throw 'The installer checksum is incorrect. Nothing will be installed.' }; if ($setupAsset.digest -and $setupAsset.digest -cne ('sha256:' + $actualHash)) { throw 'The GitHub asset checksum disagrees with the release manifest.' }; $stream = [IO.File]::OpenRead($installer); try { if ($stream.ReadByte() -ne 77 -or $stream.ReadByte() -ne 90) { throw 'The downloaded file is not a Windows executable.' }; $stream.Position = 60; $offsetBytes = New-Object byte[] 4; if ($stream.Read($offsetBytes, 0, 4) -ne 4) { throw 'The executable header is incomplete.' }; $peOffset = [BitConverter]::ToInt32($offsetBytes, 0); if ($peOffset -lt 64 -or $peOffset -gt ($stream.Length - 24)) { throw 'The executable header is invalid.' }; $stream.Position = $peOffset; if ($stream.ReadByte() -ne 80 -or $stream.ReadByte() -ne 69 -or $stream.ReadByte() -ne 0 -or $stream.ReadByte() -ne 0) { throw 'The Windows executable signature is invalid.' }; } finally { $stream.Dispose() }; Write-Host ('Verified SHA-256: ' + $actualHash); Write-Host ('Installer: ' + $installer); if ($env:JARVIS_SETUP_VERIFY_ONLY -eq '1') { Write-Host 'Verification completed; installer launch was not requested.'; exit 0 }; Set-Content -LiteralPath $installer -Stream Zone.Identifier -Value @('[ZoneTransfer]', 'ZoneId=3', ('HostUrl=' + $baseUrl + 'JARVIS-Setup.exe')) -Encoding ASCII; Write-Host 'Opening the standard Windows installer. Follow its prompts, then open JARVIS from Start.'; $process = Start-Process -FilePath $installer -PassThru -Wait; if ($process.ExitCode -ne 0) { throw ('The installer was cancelled or returned exit code ' + $process.ExitCode + '. You can run setup again.') }; Write-Host 'Installer completed. Open JARVIS and follow its local AI and owner setup.'; exit 0 } catch { Write-Host ('Setup stopped: ' + $_.Exception.Message) -ForegroundColor Red; if ($setupDir -and (Test-Path -LiteralPath $setupDir)) { Remove-Item -LiteralPath $setupDir -Recurse -Force -ErrorAction SilentlyContinue }; Write-Host 'You can also download JARVIS-Setup.exe from https://github.com/cutebody42-web/JARVIS-OS-V.2/releases'; exit 1 }"
set "JARVIS_SETUP_EXIT=%ERRORLEVEL%"
echo.
if not "%JARVIS_SETUP_VERIFY_ONLY%"=="1" pause
exit /b %JARVIS_SETUP_EXIT%
