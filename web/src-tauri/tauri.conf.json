{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JARVIS",
  "version": "2.0.0",
  "identifier": "ai.jarvis.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "JARVIS",
        "width": 1440,
        "height": 900,
        "minWidth": 390,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://[::1]:* ws://127.0.0.1:* ws://[::1]:* https: wss:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; media-src 'self' blob:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "resources": ["resources/libsodium.dll"],
    "windows": {"nsis": {"installMode": "currentUser", "installerHooks": "./windows/hooks.nsh"}},
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "One continuous local-first JARVIS",
    "longDescription": "JARVIS is a local-first personal AI with one identity and synchronized desktop/mobile continuity.",
    "android": {
      "minSdkVersion": 28,
      "versionCode": 2000000
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "jarvis"
          ],
          "appLink": false
        }
      ],
      "desktop": {
        "schemes": [
          "jarvis"
        ]
      }
    }
  }
}
